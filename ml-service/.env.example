# AgriGenius ML service settings. Copy to ml-service/.env for local overrides.
# Real .env files are gitignored. This service must stay private: only the
# Spring Boot backend calls it (see ML_SERVICE_BASE_URL in the root .env.example).

# local | test | staging | production
ML_APP_ENV=local
ML_SERVICE_NAME=agrigenius-ml-service
ML_SERVICE_VERSION=0.1.0

# Bind to loopback by default so the service is not reachable from other machines.
ML_HOST=127.0.0.1
ML_PORT=8001

# CRITICAL | ERROR | WARNING | INFO | DEBUG
ML_LOG_LEVEL=INFO

# Leave unset to enable /docs everywhere except production.
# ML_DOCS_ENABLED=true

# REQUIRED. Shared secret the Spring Boot backend sends in the X-Internal-Api-Key header
# (ADR-0004). At least 32 characters; must equal ML_SERVICE_API_KEY in the root .env.
# The placeholder below is rejected at startup on purpose.
# Generate: openssl rand -base64 48
ML_INTERNAL_API_KEY=REPLACE_WITH_BASE64_OF_48_RANDOM_BYTES

# Crop model artifacts: <ML_MODEL_DIR>/<ML_CROP_MODEL_VERSION>/{model.joblib,metadata.json}.
# Defaults to ml-service/models/crop_recommendation and version 1.0.0.
# ML_MODEL_DIR=models/crop_recommendation
# ML_CROP_MODEL_VERSION=1.0.0
