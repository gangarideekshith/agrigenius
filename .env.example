# Copy to a local .env file and fill in values. Never commit real secrets.
# The Spring Boot backend imports this file (backend/src/main/resources/application.yml);
# real environment variables override values here.

# NOTE: Spring Boot does not read the active profile from .env. Set it as a real environment
# variable or on the command line (./mvnw spring-boot:run -Dspring-boot.run.profiles=local).
# Without a profile, API docs stay off. Use "prod" for deployments.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# Local PostgreSQL container (infra/docker-compose.yml). The container creates
# this database and user on first start of an empty volume.
POSTGRES_DB=agrigenius
POSTGRES_USER=agrigenius_app
POSTGRES_PASSWORD=CHANGE_ME_LOCALLY
POSTGRES_PORT=5432

# Spring Boot database connection. Optional: each DB_* falls back to the matching
# POSTGRES_* value above (DB_PORT -> POSTGRES_PORT, DB_NAME -> POSTGRES_DB, and so on).
# Set them only to point the backend at a different database or user.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agrigenius
DB_USERNAME=agrigenius_app
DB_PASSWORD=CHANGE_ME_LOCALLY

JWT_ISSUER=agrigenius
JWT_SECRET=REPLACE_WITH_A_SECURE_LOCAL_SECRET
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# Provider credentials are optional until their integrations are implemented.
WEATHER_API_KEY=
LLM_PROVIDER=
LLM_API_KEY=
FIREBASE_CREDENTIALS_PATH=

# Browser origins allowed to call the backend API (comma-separated, no wildcards).
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Internal-only service address; never expose this value in Angular config.
ML_SERVICE_BASE_URL=http://localhost:8001
ML_SERVICE_CONNECT_TIMEOUT=2s
ML_SERVICE_READ_TIMEOUT=5s
