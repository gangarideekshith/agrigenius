# Copy to a local .env file and fill in values. Never commit real secrets.
# The Spring Boot backend imports this file (backend/src/main/resources/application.yml);
# real environment variables override values here.

# NOTE: Spring Boot does not read the active profile from .env. Set it as a real environment
# variable or on the command line (./mvnw spring-boot:run -Dspring-boot.run.profiles=local).
# Without a profile, API docs stay off. Use "prod" for deployments.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# Local PostgreSQL container (infra/docker-compose.yml). The container creates this database
# and its OWNER user on first start of an empty volume. Flyway also connects as this owner
# to run migrations. The running backend does NOT use it (see DB_* below).
POSTGRES_DB=agrigenius
POSTGRES_USER=agrigenius_owner
POSTGRES_PASSWORD=CHANGE_ME_LOCALLY
POSTGRES_PORT=5432

# Least-privilege application role used by the running backend (REQUIRED).
# Flyway's afterMigrate callback creates/updates this role and grants it data-only access
# (SELECT, INSERT, UPDATE, DELETE). It must differ from POSTGRES_USER.
# DB_PASSWORD: 16-128 characters of A-Z a-z 0-9 + / = _ . -  (generate: openssl rand -base64 24)
# DB_HOST/DB_PORT/DB_NAME are optional and fall back to localhost/POSTGRES_PORT/POSTGRES_DB.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agrigenius
DB_USERNAME=agrigenius_app
DB_PASSWORD=CHANGE_ME_16_PLUS_CHARS

# JWT access tokens (REQUIRED). JWT_SECRET must be base64 for at least 32 random bytes;
# the placeholder below is rejected at startup on purpose.
# Generate: Git Bash `openssl rand -base64 48`
#           PowerShell 7 `[Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(48))`
JWT_ISSUER=agrigenius
JWT_SECRET=REPLACE_WITH_BASE64_OF_48_RANDOM_BYTES
# Access-token lifetime in minutes (1-120). 30 until refresh tokens exist (ADR-0003).
JWT_ACCESS_TOKEN_MINUTES=30
# Unused until refresh tokens are implemented (deferred, decision D1).
JWT_REFRESH_TOKEN_DAYS=7

# Provider credentials are optional until their integrations are implemented.
WEATHER_API_KEY=
LLM_PROVIDER=
LLM_API_KEY=
FIREBASE_CREDENTIALS_PATH=

# Browser origins allowed to call the backend API (comma-separated, no wildcards).
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Internal-only service address; never expose this value in Angular config.
ML_SERVICE_BASE_URL=http://localhost:8001
ML_SERVICE_CONNECT_TIMEOUT=2s
ML_SERVICE_READ_TIMEOUT=5s
# Shared secret sent as X-Internal-Api-Key to the ML service (ADR-0004). REQUIRED.
# Must match ML_INTERNAL_API_KEY in ml-service/.env; at least 32 characters.
# Generate once and use the same value in both files: openssl rand -base64 48
ML_SERVICE_API_KEY=REPLACE_WITH_SHARED_KEY_SAME_AS_ML_INTERNAL_API_KEY

# Agriculture chatbot (optional; ADR-0006). Leave ANTHROPIC_API_KEY empty to keep chat disabled
# (chat endpoints return 503 CHAT_DISABLED; the rest of the backend works). Backend only: never
# put this key in Angular config, logs or committed files.
# Chat is enabled only when CHAT_PROVIDER=anthropic AND ANTHROPIC_API_KEY is set (otherwise 503 CHAT_DISABLED).
CHAT_PROVIDER=none
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-opus-5-5
CHAT_EFFORT=low
CHAT_MAX_OUTPUT_TOKENS=1024
CHAT_MESSAGES_PER_10_MIN=20
CHAT_DAILY_MESSAGE_LIMIT=40
# Global input + output tokens per day across all farmers; chat returns 503 when spent.
CHAT_DAILY_TOKEN_BUDGET=2000000
# Minimum cosine similarity for retrieved knowledge; tune on the gold-question set.
CHAT_SIMILARITY_THRESHOLD=0.75
# Where the in-process embedding model (intfloat/multilingual-e5-small, ONNX) is cached; downloaded on first start.
EMBEDDING_MODEL_CACHE_DIR=

# Knowledge retrieval (RAG): set EMBEDDING_PROVIDER=e5-onnx and VECTOR_STORE_TYPE=pgvector to enable.
EMBEDDING_PROVIDER=none
VECTOR_STORE_TYPE=none
